PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DRIVER=file
DATA_DIR=./data
SOROBUILD_RUNNER_IMAGE=sorobuild-runner:25
# DB_URI=mongodb://127.0.0.1:27017/sorobuild
# For Compose, create this directory with API_UID/API_GID ownership on the host.
JOBS_DIR=/tmp/sorobuild-jobs
# AI_MODEL=qwen2.5-coder:7b
# AI_URL=http://127.0.0.1:11434/api/chat

# Set to 1 only when the API is behind a single trusted reverse proxy (Nginx).
# Compose defaults to 1 and binds the API port to loopback.
TRUST_PROXY_HOPS=0
